# ETDOX Enterprise Procurement Platform - Backend Environment Variables

# Node & Server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://etdox_user:EtDoxDb2026NewPass8391@localhost:5432/etdox
DB_POOL_MAX=10
DB_SSL=false

# Authentication & Security
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=8h
JWT_ISSUER=etdox-api
JWT_AUDIENCE=etdox-app
WEBHOOK_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS_FROM_NODE_CRYPTO_RANDOMBYTES_32

# Multi-Tenancy & Demo Defaults
ETDOX_DEMO_AUTH=false
ETDOX_DEMO_TENANT_ID=b4383f9e-8e4a-42d7-9d34-ba59e5ea9a9e
DEFAULT_CURRENCY=USD

# Redis & Background Workers (Optional)
REDIS_URL=redis://localhost:6379

# SMTP Email Service Configuration
# Standard SMTP options:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-or-app-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_FROM_NAME=ETDOX Enterprise Platform

# Alternatively, convenient Gmail shortcut:
# EMAIL=your-email@gmail.com
# SECRET=your-16-char-app-password

# Email and Token TTLs (in minutes)
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
