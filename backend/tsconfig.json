
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": false,
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": false,
    "noEmit": true
  },
  "include": ["src/**/*.js", "tests/**/*.js", "*.js"],
  "exclude": ["node_modules", "dist"]
}
